String waouhStockRecommendationText(WaouhStockInsight insight) {
  final lines = <String>[
    'Analyse de stock',
    insight.summary,
    '',
    'Réapprovisionnement conseillé :',
    ...insight.items.map(
      (item) =>
          '• ${item.name} : +${item.recommendedQuantity} ${item.unit ?? 'unités'}',
    ),
  ];
  return lines.join('\n');
}

