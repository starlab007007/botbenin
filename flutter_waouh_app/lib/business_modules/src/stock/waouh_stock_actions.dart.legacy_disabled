class _StockAlertSettingsSheet extends StatefulWidget {
  const _StockAlertSettingsSheet({required this.repository});

  final WaouhStockRepository repository;

  @override
  State<_StockAlertSettingsSheet> createState() =>
      _StockAlertSettingsSheetState();
}

class _StockAlertSettingsSheetState extends State<_StockAlertSettingsSheet> {
  final _recipient = TextEditingController();
  List<WaouhStockPartner> _partners = const [];
  List<WaouhStockWhatsAppSession> _sessions = const [];
  String? _partnerId;
  String? _sessionName;
  bool _enabled = false;
  bool _loading = true;
  bool _saving = false;
  Object? _error;

  @override
  void initState() {
    super.initState();
    _load();
  }

  @override
  void dispose() {
    _recipient.dispose();
    super.dispose();
  }

  Future<void> _load() async {
    try {
      final results = await Future.wait([
        widget.repository.fetchPartners(),
        widget.repository.fetchWhatsAppSessions(),
      ]);
      if (!mounted) return;
      final partners = results[0] as List<WaouhStockPartner>;
      final sessions = results[1] as List<WaouhStockWhatsAppSession>;
      setState(() {
        _partners = partners;
        _sessions = sessions;
        _partnerId = partners.isEmpty ? null : partners.first.id;
        final connected = sessions.where((item) => item.isConnected).toList();
        _sessionName = connected.isEmpty
            ? (sessions.isEmpty ? null : sessions.first.sessionName)
            : connected.first.sessionName;
      });
      await _loadSetting();
    } catch (error) {
      if (mounted) setState(() => _error = error);
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  Future<void> _loadSetting() async {
    final partnerId = _partnerId;
    if (partnerId == null) return;
    try {
      final setting = await widget.repository.fetchAlertSetting(partnerId);
      if (!mounted || setting == null) return;
      setState(() {
        _enabled = setting.enabled;
        _recipient.text = setting.recipient ?? '';
        _sessionName = setting.sessionName ?? _sessionName;
      });
    } catch (error) {
      if (mounted) setState(() => _error = error);
    }
  }

  Future<void> _save() async {
    final partnerId = _partnerId;
    if (partnerId == null) {
      setState(
          () => _error = StateError('Créez d’abord votre espace partenaire.'));
      return;
    }
    setState(() {
      _saving = true;
      _error = null;
    });
    try {
      await widget.repository.saveAlertSetting(
        partnerId: partnerId,
        enabled: _enabled,
        recipient: _recipient.text,
        sessionName: _sessionName,
      );
      if (!mounted) return;
      Navigator.pop(context);
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Alertes Stock enregistrées.')),
      );
    } catch (error) {
      if (mounted) setState(() => _error = error);
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  @override
  Widget build(BuildContext context) => WaouhBusinessUiScope(
        child: SafeArea(
          top: false,
          child: Container(
            padding: EdgeInsets.fromLTRB(
              20,
              20,
              20,
              20 + MediaQuery.viewInsetsOf(context).bottom,
            ),
            decoration: const BoxDecoration(
              color: WaouhBusinessColors.pearl,
              borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
            ),
            child: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text(
                    'Alertes Stock WhatsApp',
                    style: TextStyle(fontSize: 20, fontWeight: FontWeight.w900),
                  ),
                  const SizedBox(height: 5),
                  const Text(
                    'Une alerte est envoyée après un mouvement qui passe sous le seuil. Une seule alerte par produit et par jour.',
                    style: TextStyle(
                      color: WaouhBusinessColors.muted,
                      height: 1.3,
                    ),
                  ),
                  const SizedBox(height: 18),
                  if (_loading)
                    const Center(child: CircularProgressIndicator())
                  else ...[
                    if (_partners.isEmpty)
                      const _StockActionError(
                        message:
                            'Aucun espace partenaire n’est disponible pour configurer une alerte.',
                      )
                    else ...[
                      DropdownButtonFormField<String>(
                        value: _partnerId,
                        decoration:
                            const InputDecoration(labelText: 'Espace stock'),
                        items: _partners
                            .map(
                              (partner) => DropdownMenuItem(
                                value: partner.id,
                                child: Text(partner.name),
                              ),
                            )
                            .toList(),
                        onChanged: _saving
                            ? null
                            : (value) async {
                                setState(() {
                                  _partnerId = value;
                                  _enabled = false;
                                  _recipient.clear();
                                });
                                await _loadSetting();
                              },
                      ),
                      const SizedBox(height: 10),
                      SwitchListTile.adaptive(
                        contentPadding: EdgeInsets.zero,
                        value: _enabled,
                        title: const Text(
                          'Activer les alertes',
                          style: TextStyle(fontWeight: FontWeight.w800),
                        ),
                        subtitle: const Text(
                          'Déclenchées uniquement sur passage sous le seuil.',
                          style: TextStyle(
                            color: WaouhBusinessColors.muted,
                            fontSize: 12,
                          ),
                        ),
                        onChanged: _saving
                            ? null
                            : (value) => setState(() => _enabled = value),
                      ),
                      if (_enabled) ...[
                        const SizedBox(height: 6),
                        DropdownButtonFormField<String>(
                          value: _sessionName,
                          decoration: const InputDecoration(
                            labelText: 'Ligne WhatsApp',
                          ),
                          items: _sessions
                              .map(
                                (item) => DropdownMenuItem(
                                  value: item.sessionName,
                                  child: Text(item.label),
                                ),
                              )
                              .toList(),
                          onChanged: _saving
                              ? null
                              : (value) => setState(() => _sessionName = value),
                        ),
                        const SizedBox(height: 10),
                        TextField(
                          controller: _recipient,
                          keyboardType: TextInputType.phone,
                          decoration: const InputDecoration(
                            labelText: 'Numéro WhatsApp destinataire',
                            hintText: 'Ex. +229 97 00 00 00',
                          ),
                        ),
                      ],
                      const SizedBox(height: 18),
                      SizedBox(
                        width: double.infinity,
                        child: FilledButton.icon(
                          onPressed: _saving ? null : _save,
                          icon: const Icon(Icons.notifications_active_outlined),
                          label: const Text('Enregistrer les alertes'),
                        ),
                      ),
                    ],
                  ],
                  if (_error != null) ...[
                    const SizedBox(height: 14),
                    _StockActionError(message: '$_error'),
                  ],
                ],
              ),
            ),
          ),
        ),
      );
}

