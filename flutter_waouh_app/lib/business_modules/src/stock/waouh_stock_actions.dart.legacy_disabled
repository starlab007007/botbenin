class _WaouhStockCreateProductSheetState
    extends State<_WaouhStockCreateProductSheet> {
  final _name = TextEditingController();
  final _category = TextEditingController();
  final _unit = TextEditingController();
  final _price = TextEditingController();
  final _stock = TextEditingController(text: '0');
  final _minimum = TextEditingController(text: '0');
  final _target = TextEditingController();
  final _description = TextEditingController();

  late String _partnerId;
  List<WaouhStockBusiness> _businesses = const [];
  String? _businessId;
  bool _loadingBusinesses = true;

  @override
  void initState() {
    super.initState();
    _partnerId = widget.partners.first.id;
    _loadBusinesses();
  }

  @override
  void dispose() {
    _name.dispose();
    _category.dispose();
    _unit.dispose();
    _price.dispose();
    _stock.dispose();
    _minimum.dispose();
    _target.dispose();
    _description.dispose();
    super.dispose();
  }

  Future<void> _loadBusinesses() async {
    setState(() {
      _loadingBusinesses = true;
      _businesses = const [];
      _businessId = null;
    });
    try {
      final values = await widget.repository.fetchBusinesses(_partnerId);
      if (!mounted) return;
      setState(() {
        _businesses = values;
        _businessId = values.isEmpty ? null : values.first.id;
      });
    } catch (error) {
      if (!mounted) return;
      ScaffoldMessenger.of(context)
          .showSnackBar(SnackBar(content: Text('$error')));
    } finally {
      if (mounted) setState(() => _loadingBusinesses = false);
    }
  }

  void _submit() {
    final stock = int.tryParse(_stock.text.trim());
    final minimum = int.tryParse(_minimum.text.trim());
    final target =
        _target.text.trim().isEmpty ? null : int.tryParse(_target.text.trim());
    final price = _price.text.trim().isEmpty
        ? null
        : num.tryParse(_price.text.trim().replaceAll(',', '.'));
    if (_name.text.trim().isEmpty || _businessId == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Nom et activité sont requis.')),
      );
      return;
    }
    if (stock == null ||
        minimum == null ||
        stock < 0 ||
        minimum < 0 ||
        (target != null && (target < 0 || target < minimum)) ||
        (_price.text.trim().isNotEmpty && price == null)) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
            content: Text('Vérifiez les quantités, le prix et l’objectif.')),
      );
      return;
    }
    Navigator.of(context).pop(
      WaouhStockNewProduct(
        partnerId: _partnerId,
        businessId: _businessId!,
        name: _name.text.trim(),
        stock: stock,
        minimum: minimum,
        target: target,
        category: _category.text.trim().isEmpty ? null : _category.text.trim(),
        unit: _unit.text.trim().isEmpty ? null : _unit.text.trim(),
        price: price,
        description:
            _description.text.trim().isEmpty ? null : _description.text.trim(),
      ),
    );
  }

  @override
  Widget build(BuildContext context) => WaouhBusinessUiScope(
        child: SafeArea(
          top: false,
          child: Container(
            decoration: const BoxDecoration(
              color: WaouhBusinessColors.pearl,
              borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
            ),
            padding: EdgeInsets.fromLTRB(
              20,
              16,
              20,
              20 + MediaQuery.viewInsetsOf(context).bottom,
            ),
            child: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Center(
                    child: Container(
                      width: 44,
                      height: 4,
                      decoration: BoxDecoration(
                        color: WaouhBusinessColors.line,
                        borderRadius: BorderRadius.circular(99),
                      ),
                    ),
                  ),
                  const SizedBox(height: 18),
                  Row(
                    children: [
                      const Expanded(
                        child: Text(
                          'Ajouter un produit',
                          style: TextStyle(
                              fontSize: 21, fontWeight: FontWeight.w900),
                        ),
                      ),
                      IconButton(
                        onPressed: () => Navigator.of(context).pop(),
                        icon: const Icon(Icons.close_rounded),
                      ),
                    ],
                  ),
                  const SizedBox(height: 16),
                  DropdownButtonFormField<String>(
                    value: _partnerId,
                    decoration:
                        const InputDecoration(labelText: 'Espace stock'),
                    items: widget.partners
                        .map((partner) => DropdownMenuItem(
                              value: partner.id,
                              child: Text(partner.name),
                            ))
                        .toList(),
                    onChanged: (value) {
                      if (value == null || value == _partnerId) return;
                      setState(() => _partnerId = value);
                      _loadBusinesses();
                    },
                  ),
                  const SizedBox(height: 12),
                  if (_loadingBusinesses)
                    const LinearProgressIndicator()
                  else if (_businesses.isEmpty)
                    const _WaouhStockNoBusinessHint()
                  else
                    DropdownButtonFormField<String>(
                      value: _businessId,
                      decoration: const InputDecoration(labelText: 'Activité'),
                      items: _businesses
                          .map((business) => DropdownMenuItem(
                                value: business.id,
                                child: Text(business.name),
                              ))
                          .toList(),
                      onChanged: (value) => setState(() => _businessId = value),
                    ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: _name,
                    textCapitalization: TextCapitalization.sentences,
                    decoration:
                        const InputDecoration(labelText: 'Nom du produit'),
                  ),
                  const SizedBox(height: 12),
                  Row(
                    children: [
                      Expanded(
                        child: TextField(
                          controller: _category,
                          textCapitalization: TextCapitalization.sentences,
                          decoration:
                              const InputDecoration(labelText: 'Catégorie'),
                        ),
                      ),
                      const SizedBox(width: 10),
                      Expanded(
                        child: TextField(
                          controller: _unit,
                          textCapitalization: TextCapitalization.sentences,
                          decoration: const InputDecoration(labelText: 'Unité'),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: _price,
                    keyboardType:
                        const TextInputType.numberWithOptions(decimal: true),
                    decoration: const InputDecoration(
                        labelText: 'Prix unitaire (facultatif)'),
                  ),
                  const SizedBox(height: 12),
                  Row(
                    children: [
                      Expanded(
                        child: TextField(
                          controller: _stock,
                          keyboardType: TextInputType.number,
                          decoration:
                              const InputDecoration(labelText: 'Stock initial'),
                        ),
                      ),
                      const SizedBox(width: 10),
                      Expanded(
                        child: TextField(
                          controller: _minimum,
                          keyboardType: TextInputType.number,
                          decoration:
                              const InputDecoration(labelText: 'Seuil minimum'),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: _target,
                    keyboardType: TextInputType.number,
                    decoration: const InputDecoration(
                        labelText: 'Objectif stock (facultatif)'),
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: _description,
                    maxLines: 2,
                    decoration: const InputDecoration(
                        labelText: 'Description (facultative)'),
                  ),
                  const SizedBox(height: 20),
                  SizedBox(
                    width: double.infinity,
                    child: FilledButton.icon(
                      onPressed: _loadingBusinesses || _businessId == null
                          ? null
                          : _submit,
                      icon: const Icon(Icons.add_rounded),
                      label: const Text('Ajouter au stock'),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      );
}

class _WaouhStockNoBusinessHint extends StatelessWidget {
  const _WaouhStockNoBusinessHint();

  @override
  Widget build(BuildContext context) => Container(
        padding: const EdgeInsets.all(14),
        decoration: BoxDecoration(
          color: WaouhBusinessColors.orange.withValues(alpha: 0.10),
          borderRadius: BorderRadius.circular(16),
        ),
        child: const Row(
          children: [
            Icon(Icons.storefront_outlined, color: WaouhBusinessColors.orange),
            SizedBox(width: 10),
            Expanded(
              child: Text(
                'Créez d’abord une activité liée à cet espace partenaire pour y ajouter des produits.',
                style: TextStyle(color: WaouhBusinessColors.muted, height: 1.3),
              ),
            ),
          ],
        ),
      );
}
