class _RecommendationWhatsAppSheet extends StatefulWidget {
  const _RecommendationWhatsAppSheet({
    required this.repository,
    required this.message,
  });

  final WaouhStockRepository repository;
  final String message;

  @override
  State<_RecommendationWhatsAppSheet> createState() =>
      _RecommendationWhatsAppSheetState();
}

class _RecommendationWhatsAppSheetState
    extends State<_RecommendationWhatsAppSheet> {
  final _recipient = TextEditingController();
  List<WaouhStockWhatsAppSession> _sessions = const [];
  String? _session;
  Object? _error;
  bool _loading = true;
  bool _sending = false;

  @override
  void initState() {
    super.initState();
    _loadSessions();
  }

  @override
  void dispose() {
    _recipient.dispose();
    super.dispose();
  }

  Future<void> _loadSessions() async {
    try {
      final sessions = await widget.repository.fetchWhatsAppSessions();
      if (!mounted) return;
      setState(() {
        _sessions = sessions;
        final connected = sessions.where((item) => item.isConnected).toList();
        _session = connected.isEmpty ? null : connected.first.sessionName;
        _session ??= sessions.isEmpty ? null : sessions.first.sessionName;
      });
    } catch (error) {
      if (mounted) setState(() => _error = error);
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  Future<void> _send() async {
    final session = _session;
    if (session == null || _recipient.text.trim().isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Choisissez une ligne et indiquez le destinataire.'),
        ),
      );
      return;
    }
    setState(() => _sending = true);
    try {
      await widget.repository.sendRecommendation(
        sessionName: session,
        recipient: _recipient.text.trim(),
        message: widget.message,
      );
      if (!mounted) return;
      Navigator.of(context).pop();
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Recommandation envoyée sur WhatsApp.')),
      );
    } catch (error) {
      if (mounted) setState(() => _error = error);
    } finally {
      if (mounted) setState(() => _sending = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return WaouhBusinessUiScope(
      child: SafeArea(
        top: false,
        child: Container(
          padding: EdgeInsets.fromLTRB(
            20,
            20,
            20,
            20 + MediaQuery.viewInsetsOf(context).bottom,
          ),
          decoration: const BoxDecoration(
            color: WaouhBusinessColors.pearl,
            borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
          ),
          child: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'Envoyer la recommandation',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.w900),
                ),
                const SizedBox(height: 5),
                const Text(
                  'L’envoi reste soumis à votre confirmation.',
                  style: TextStyle(color: WaouhBusinessColors.muted),
                ),
                const SizedBox(height: 18),
                if (_loading)
                  const Center(child: CircularProgressIndicator())
                else ...[
                  if (_sessions.isEmpty)
                    const _StockActionError(
                      message:
                          'Aucune ligne WhatsApp n’est disponible. Connectez une ligne dans WhatsApp IA Studio.',
                    )
                  else ...[
                    DropdownButtonFormField<String>(
                      value: _session,
                      decoration: const InputDecoration(
                        labelText: 'Ligne WhatsApp',
                      ),
                      items: _sessions
                          .map(
                            (item) => DropdownMenuItem<String>(
                              value: item.sessionName,
                              child: Text(item.label),
                            ),
                          )
                          .toList(),
                      onChanged: _sending
                          ? null
                          : (value) => setState(() => _session = value),
                    ),
                    const SizedBox(height: 12),
                    TextField(
                      controller: _recipient,
                      keyboardType: TextInputType.phone,
                      decoration: const InputDecoration(
                        labelText: 'Numéro destinataire',
                        hintText: 'Ex. 22997000000@c.us',
                      ),
                    ),
                    const SizedBox(height: 12),
                    Container(
                      padding: const EdgeInsets.all(12),
                      decoration: BoxDecoration(
                        color: WaouhBusinessColors.blue.withValues(alpha: .08),
                        borderRadius: BorderRadius.circular(14),
                      ),
                      child: Text(
                        widget.message,
                        maxLines: 7,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(fontSize: 12.5, height: 1.35),
                      ),
                    ),
                    const SizedBox(height: 18),
                    SizedBox(
                      width: double.infinity,
                      child: FilledButton.icon(
                        onPressed: _sending ? null : _send,
                        icon: _sending
                            ? const SizedBox(
                                height: 18,
                                width: 18,
                                child: CircularProgressIndicator(
                                  strokeWidth: 2,
                                  color: Colors.white,
                                ),
                              )
                            : const Icon(Icons.send_rounded),
                        label: const Text('Envoyer sur WhatsApp'),
                      ),
                    ),
                  ],
                ],
                if (_error != null) ...[
                  const SizedBox(height: 14),
                  _StockActionError(message: '$_error'),
                ],
              ],
            ),
          ),
        ),
      ),
    );
  }
}

